{
  "mcpServers": {
    "mcp": {
      "command": "npx",
      "args": ["-y", "@unleash/mcp@0.5.0", "--log-level", "error"],
      "env": {
        "UNLEASH_BASE_URL": "${UNLEASH_BASE_URL}",
        "UNLEASH_PAT": "${UNLEASH_PAT}",
        "UNLEASH_DEFAULT_PROJECT": "${UNLEASH_DEFAULT_PROJECT:-default}"
      }
    }
  }
}
